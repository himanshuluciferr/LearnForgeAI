APP_ENV=local
LOG_LEVEL=INFO

# Microsoft Foundry (models + tracing for Agent Framework)
# Note the project path — the account root and *.cognitiveservices.azure.com will not work.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=learnforge-knowledge

# Cosmos DB
COSMOS_ENDPOINT=
COSMOS_DATABASE=learnforge

# Blob Storage
BLOB_ACCOUNT_URL=
BLOB_CONTAINER=generated-courses

# Teams / M365 Agent
MICROSOFT_APP_ID=
MICROSOFT_APP_TENANT_ID=
BACKEND_BASE_URL=http://localhost:8000

# Auth uses DefaultAzureCredential locally and ManagedIdentityCredential in production.
# Load with load_dotenv(override=False) so Foundry runtime values win.
# Never commit secrets — this file is a template only.
