APP_ENV=local
LOG_LEVEL=INFO

# Microsoft Foundry (models + tracing for Agent Framework)
# Note the project path — the account root and *.cognitiveservices.azure.com will not work.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT_NAME=

# Azure AI Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=learnforge-knowledge

# Cosmos DB
COSMOS_ENDPOINT=
COSMOS_DATABASE=learnforge

# Blob Storage. Leave empty to keep published courses in generated_courses/ on disk.
# The container name is fixed in code (courses) — one less thing to get out of step.
BLOB_ACCOUNT_URL=

# Teams / M365 Agent
# From the Azure Bot registration. Leave both blank to run against the Bot Framework Emulator,
# which is the only client that can reach an unauthenticated bot.
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TENANT_ID=
BACKEND_BASE_URL=http://localhost:8000

# Auth uses DefaultAzureCredential locally and ManagedIdentityCredential in production.
# Load with load_dotenv(override=False) so Foundry runtime values win.
# Never commit secrets — this file is a template only.
